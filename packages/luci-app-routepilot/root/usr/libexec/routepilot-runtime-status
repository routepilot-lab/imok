#!/usr/bin/python3
"""Read ACL: local metadata only, no downloads, registration or installation."""
import json
import sys
sys.path.insert(0, '/usr/lib/routepilot')
try:
    if len(sys.argv) != 1:
        raise ValueError()
    import runtime_maintenance
    print(json.dumps(runtime_maintenance.status(), ensure_ascii=False))
except Exception:
    print(json.dumps({'error': '无法读取 WARP 维护状态，请刷新或由管理员检查；未重置记录'}, ensure_ascii=False))
    raise SystemExit(1) from None
