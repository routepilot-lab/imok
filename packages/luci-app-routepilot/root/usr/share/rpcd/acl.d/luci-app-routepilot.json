{
  "luci-app-routepilot": {
    "description": "Manage only imok Cloudflare configuration",
    "read": {
      "uci": [
        "routepilot"
      ],
      "file": {
        "/var/run/routepilot/status.json": [
          "read"
        ],
        "/var/run/routepilot/prepared-exit-test.json": [
          "read"
        ],
        "/var/run/routepilot/update.json": [
          "read"
        ],
        "/var/run/routepilot/connectivity.json": [
          "read"
        ],
        "/usr/libexec/routepilot-exits": [
          "exec"
        ],
        "/var/run/routepilot/receive.json": [
          "read"
        ],
        "/var/run/routepilot/dns-state.json": [
          "read"
        ],
        "/var/run/routepilot/dns-tests.json": [
          "read"
        ],
        "/var/run/routepilot/traffic.json": [
          "read"
        ],
        "/usr/libexec/routepilot-backup-list": [
          "exec"
        ],
        "/var/run/routepilot/backup-node.json": [
          "read"
        ],
        "/var/run/routepilot/backup-test.json": [
          "read"
        ],
        "/var/run/routepilot/cloud-state.json": [
          "read"
        ],
        "/var/run/routepilot/backup-scan.json": [
          "read"
        ],
        "/var/run/routepilot/relay-tests.json": [
          "read"
        ],
        "/var/run/routepilot/relay-observed.json": [
          "read"
        ],
        "/var/run/routepilot/warp-state.json": [
          "read"
        ],
        "/var/run/routepilot/exit-observation.json": [
          "read"
        ],
        "/var/run/routepilot/connection-events.json": [
          "read"
        ],
        "/usr/share/routepilot/version.json": [
          "read"
        ],
        "/var/run/routepilot/cloud-directory-state.json": [
          "read"
        ],
        "/usr/libexec/routepilot-clients-list": [
          "exec"
        ],
        "/usr/libexec/routepilot-device-usage": [
          "exec"
        ],
        "/usr/libexec/routepilot-runtime-status": [
          "exec"
        ],
        "/var/run/routepilot/lan-dns-domestic.json": [
          "read"
        ],
        "/var/run/routepilot/lan-dns-foreign.json": [
          "read"
        ],
        "/var/run/routepilot/warp-dns-tests.json": [
          "read"
        ],
        "/var/run/routepilot/endpoint-quality.json": [
          "read"
        ],
        "/var/run/routepilot/speed-compare.json": [
          "read"
        ],
        "/var/run/routepilot/speed-tests.json": [
          "read"
        ]
      },
      "ubus": {
        "file": [
          "read",
          "exec"
        ],
        "luci-rpc": [
          "getHostHints"
        ]
      }
    },
    "write": {
      "uci": [
        "routepilot"
      ],
      "file": {
        "/usr/libexec/routepilot": [
          "exec"
        ],
        "/var/run/routepilot/endpoint-input": [
          "write"
        ],
        "/var/run/routepilot/settings-import-input": [
          "write"
        ],
        "/var/run/routepilot/endpoint-schedule-input": [
          "write"
        ],
        "/var/run/routepilot/endpoint-recover-input": [
          "write"
        ],
        "/var/run/routepilot/requests/auth-input-*.json": [
          "write"
        ],
        "/var/run/routepilot/requests/backup-input-*.json": [
          "write"
        ],
        "/var/run/routepilot/requests/cloud-input-*.json": [
          "write"
        ],
        "/var/run/routepilot/requests/relay-input-*.json": [
          "write"
        ],
        "/var/run/routepilot/requests/organization-input-*.json": [
          "write"
        ],
        "/var/run/routepilot/requests/rules-input-*.json": [
          "write"
        ],
        "/usr/libexec/routepilot-clients": [
          "exec"
        ],
        "/var/run/routepilot/requests/client-input-*.json": [
          "write"
        ],
        "/usr/libexec/routepilot-runtime": [
          "exec"
        ],
        "/var/run/routepilot/requests/runtime-input-*.json": [
          "write"
        ],
        "/opt/routepilot/runtime-uploads/runtime.tgz": [
          "write"
        ],
        "/var/run/routepilot/requests/speed-compare-input-*.json": [
          "write"
        ],
        "/var/run/routepilot/requests/warp-dns-input-*.json": [
          "write"
        ]
      },
      "ubus": {
        "uci": [
          "commit"
        ],
        "file": [
          "exec",
          "write"
        ]
      }
    }
  }
}
