#!/bin/sh /etc/rc.common
USE_PROCD=1
START=97
STOP=10
start_service() {
	procd_open_instance runtime_check
	procd_set_param command /usr/libexec/routepilot-runtime watch
	procd_set_param nice 10
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
	procd_open_instance main
	procd_set_param command /usr/libexec/routepilot run
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
	procd_open_instance traffic
	procd_set_param command /usr/libexec/routepilot-traffic
	procd_set_param nice 10
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
	procd_open_instance receive
	procd_set_param command /usr/libexec/routepilot-observe
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}
# The supervisor observes committed UCI itself; reload must not tear down a working generation.
reload_service() { return 0; }
